# Copia este archivo como .env.local y completa los valores

# La provee automáticamente la integración de Vercel Postgres (Neon)
# al conectar la base de datos a tu proyecto. En local, pega aquí la
# cadena de conexión que te da Neon/Vercel.
DATABASE_URL=postgres://usuario:password@host/basededatos?sslmode=require

# Cualquier cadena larga y aleatoria (sirve para firmar la sesión de login)
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Usuario y hash de contraseña para el login.
# Genera el hash con: npm run hash-password -- "tu-contraseña"
AUTH_USER=admin
AUTH_PASSWORD_HASH=
